# Server only. Relayer wallet that files demo proposals for visitors. Never commit a real key.
# Dedicated wallet, separate from the deployer, holding a little Base Sepolia and Unichain Sepolia ETH.
DEMO_RELAYER_PK=

# Optional RPC overrides (public endpoints are the defaults).
NEXT_PUBLIC_RPC_84532=
NEXT_PUBLIC_RPC_1301=
NEXT_PUBLIC_RPC_5318007=

# Public base URL of the evidence/ directory where jurors publish rationale documents.
NEXT_PUBLIC_RATIONALE_BASE_URL=

# Proposal limits for /api/propose (defaults shown).
PROPOSE_LIMIT_PER_IP_PER_HOUR=3
PROPOSE_LIMIT_GLOBAL_PER_HOUR=20
