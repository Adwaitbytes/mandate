# Copy to contracts/.env (gitignored) and fill in. Never put a private key here: scripts sign with
# `--account omni-deployer` (Foundry keystore). Addresses below are the Lasna-testnet loop from ref/FACTS.md.

# Step 1: Reactive (Lasna)
REACTIVE_RPC=https://lasna-rpc.rnk.dev/
REACTIVE_CHAIN_ID=5318007
MANDATE_OPERATOR=0x4d96Ec766088D952D62255227902eeEe1C58276c
# Cron100 (~106 s on Lasna): ~6 billed ticks per 10 min veto window vs ~60 for Cron10 (estimate_cost: ~0.035
# lREACT per reaction). Cron10 only for a live demo where 10 s timer resolution matters.
CRON_TOPIC=0xb49937fb8970e19fd46d48f7e3fb00d659deac0347f79cd7cb542f0fc1503c70
REACTIVE_FUNDING_WEI=

# Step 2: hearing chain (Base Sepolia)
HEARING_RPC=https://sepolia.base.org
HEARING_CHAIN_ID=84532
HEARING_CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585
MANDATE_REACTIVE=
MANDATE_OWNER=0x4d96Ec766088D952D62255227902eeEe1C58276c
DOCKET_FUNDING_WEI=
JUROR_ADDRESSES=
MANDATE_HASH=
MANDATE_URI=

# Step 3: each governor chain (run once per chain with these swapped)
# Base Sepolia: timestamp clock (200 ms blocks). Unichain Sepolia: block clock (1 s blocks).
GOVERNOR_RPC=https://sepolia.base.org
GOVERNOR_CHAIN_ID=84532
GOVERNOR_CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585
TIMESTAMP_CLOCK=true
VOTING_DELAY=60
VOTING_PERIOD=1800
QUORUM_PERCENT=1
DELEGATE_FUNDING_WEI=
TOKEN_NAME=Mandate Demo Votes
TOKEN_SYMBOL=MDV
GOVERNOR_NAME=Mandate Demo DAO
# Unichain Sepolia values: GOVERNOR_CHAIN_ID=1301 GOVERNOR_CALLBACK_PROXY=0x775c9B990ADe401060B78D0e98684eEf8d2466C1
# TIMESTAMP_CLOCK=false VOTING_DELAY=60 VOTING_PERIOD=1800 (blocks)

# Step 4: wiring (Lasna), comma separated, index aligned. Clock modes: 1 block number, 2 timestamp.
DOCKET=
WATCH_CHAIN_IDS=84532,1301
WATCH_GOVERNORS=
WATCH_CLOCK_MODES=2,1
WATCH_BLOCK_TIMES_MS=0,1000
WATCH_DELEGATES=
